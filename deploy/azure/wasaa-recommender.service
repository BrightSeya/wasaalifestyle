[Unit]
Description=Wasaa Lifestyle slot recommender
After=network.target

[Service]
Type=simple
User=azureuser
Group=www-data
WorkingDirectory=/var/www/wasaa/ml/slot-recommender
ExecStart=/var/www/wasaa/ml/slot-recommender/.venv/bin/gunicorn --workers 1 --bind 127.0.0.1:5001 app.api:app
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=WASAA_RISK_MODEL_ENABLED=false
Environment=WASAA_RISK_MODEL_PATH=/var/www/wasaa/ml/no-show/models/commitment_risk.joblib
Environment=WASAA_RISK_MODEL_CARD_PATH=/var/www/wasaa/ml/no-show/models/model_card.json

[Install]
WantedBy=multi-user.target
